{
  "private": true,
  "type": "module",
  "scripts": {
    "build:pages-preview": "vite build --config preview/github-pages/vite.config.ts",
    "test:pages-preview:batch-a": "node --experimental-strip-types --test tests/github-pages-preview-foundation.test.mjs",
    "test:pages-preview:batch-b": "node --experimental-strip-types --test tests/github-pages-preview-batch-b.test.mjs",
    "test:pages-preview:batch-c": "PREVIEW_BASE_PATH=/figmemento-frontend-preview/ node --test tests/github-pages-preview-final-security.test.mjs tests/github-pages-preview-artifact-smoke.test.mjs tests/github-pages-preview-rendered.test.mjs",
    "test:pages-preview": "npm run test:pages-preview:batch-a && npm run test:pages-preview:batch-b && npm run test:pages-preview:batch-c",
    "test:pages-preview:smoke": "PREVIEW_BASE_PATH=/figmemento-frontend-preview/ npm run build:pages-preview && PREVIEW_BASE_PATH=/figmemento-frontend-preview/ node --test tests/github-pages-preview-artifact-smoke.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "vite": "8.0.13"
  }
}
