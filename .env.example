# Working environment values for the FigMemento MVP.
# Keep real secrets in local .env files or the hosting provider, never in git.

# Non-secret public deployment context. The approved production identity is
# always FigMemento at https://figmemento.com; local development may use the
# loopback origin shown here. A preview deployment must provide its real origin.
APP_DEPLOYMENT_ENV=development
NEXT_PUBLIC_DEPLOYMENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# Add when Supabase is connected. Use the current publishable/secret key types.
# The publishable key may be used by the browser; the secret key is backend-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_UPLOAD_BUCKET=photogift-uploads

# Optional explicit local/test fixture source. For the local fixture catalog,
# set this to "fixture" in an ignored .env.local. Leave empty to use Supabase.
# Do not set NODE_ENV in .env.local; vinext determines the runtime mode.
# Fixture mode is rejected when the direct runtime mode is production.
PHOTOGIFT_PRODUCT_SOURCE=

# Local process-memory Cart. Leave empty/disabled unless exercising the local
# pre-checkout Cart in development or test. Never use local_fake in production.
CART_SOURCE=disabled

# Local Checkout boundary. Leave disabled unless exercising the local
# development-only Checkout evaluation. Never use local_fake in production.
LOCAL_CHECKOUT_SOURCE=disabled

# Local Newsletter is process-memory only and development/test only.
LOCAL_NEWSLETTER_SOURCE=
LOCAL_ANALYTICS_SOURCE=

# Local Contact is process-memory only and development/test only.
LOCAL_CONTACT_SOURCE=

# Customer Auth foundation mode. Leave empty/disabled unless exercising the
# local development-only fake provider. Never set local_fake in production.
CUSTOMER_AUTH_SOURCE=disabled

# Add for Stripe test checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Required before opening the local admin order dashboard.
ADMIN_PASSWORD=

# Required before future private customer-upload routes can issue a guest draft
# owner context. This is server-only. Cookie/session validity is separate from
# upload retention and must be a whole number from 300 to 604800 seconds.
PHOTOGIFT_GUEST_DRAFT_OWNER_SECRET=
PHOTOGIFT_GUEST_DRAFT_OWNER_CONTEXT_TTL_SECONDS=

# Reserved for a later storage decision. C0 does not choose R2 over Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Reserved for later approved transactional email and logistics changes.
RESEND_API_KEY=
TRACKING_API_KEY=
